# Supabase connection
# REPLACE: Copy this to .env if you later run the site through Vite.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Also supported by the frontend helpers:
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Trusted server Supabase credentials. Event confirmation generation requires
# these in Vercel Project Settings; never expose the service-role value client-side.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-supabase-service-role-key

# Upload the real official stamp to this path inside the private
# hotel-private-assets bucket. The server refuses to issue an official PDF
# when this asset is missing.
HARLA_EVENT_STAMP_PATH=event-confirmation/harla-official-stamp.png

# Future Stripe room payment variables. These are NOT required while the public
# booking flow uses manual local/international payment verification.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Optional: a dedicated ExchangeRate-API key. Without it, the server uses the
# provider's official open USD rates endpoint and still returns real dated rates.
EXCHANGE_RATE_API_KEY=your-exchangerate-api-key
SITE_URL=http://127.0.0.1:3000
# Generate a strong random value, for example: openssl rand -hex 32
BOOKING_SIGNING_SECRET=replace-with-a-long-random-server-secret
# Short-lived Room booking upload authorization. Required by /api/room-booking
# before the browser can upload a private guest ID or payment proof.
# Generate independently with: openssl rand -hex 32
ROOM_UPLOAD_TOKEN_SECRET=replace-with-at-least-32-random-characters

# Optional event-hall confirmation email. Secure PDF generation works without
# Resend, but still requires the server Supabase credentials and stamp above.
RESEND_API_KEY=re_replace_me
HARLA_EMAIL_FROM="Harla Hotel Events <events@harlahotel.com>"
# Room confirmations deliberately use a separate sender identity from Event Hall.
HARLA_ROOM_EMAIL_FROM="Harla Hotel Reservations <booking@harlahotel.com>"
# Strong server-only secret used to derive and rotate secure Event Hall customer
# portal tokens. Generate one with: openssl rand -hex 32
EVENT_PORTAL_TOKEN_SECRET=replace-with-at-least-32-random-characters
